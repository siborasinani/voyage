# Copy this file to .env and paste in your own keys — .env is gitignored,
# so they never get committed.

# Geoapify — place data (search, categories, details). Get a free key at
# https://www.geoapify.com/ (free plan: 3,000 credits/day).
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Pexels — place photos only. Geoapify remains the source of truth for
# place data; this just optionally supplies an image. Get a free key at
# https://www.pexels.com/api/ (free plan: 200 requests/hour, 20,000/month).
# The app works fine without this key — places just show Voyage's own
# no-image fallback instead of a photo.
VITE_PEXELS_API_KEY=your_pexels_api_key_here

# Supabase — accounts + database backend. Create a free project at
# https://supabase.com/, then copy both values from Project Settings ->
# API. VITE_SUPABASE_URL is the "Project URL"; VITE_SUPABASE_ANON_KEY is
# the "anon public" key. Never put the "service_role" key here (or
# anywhere in src/) — it bypasses Row Level Security and must only ever
# be used server-side, which this app has none of.
# Run supabase/migrations/0001_init.sql (see that file's own comments)
# in the project's SQL Editor once, before signing up — it creates the
# tables and security policies these env vars will be used against.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
