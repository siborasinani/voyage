# just machine-local CLI state with nothing worth tracking)
supabase/.temp

# One-time, already-run database maintenance script that names real
# account ids/display names from this project's live Supabase project
# — operational history, not something that belongs in a published
# repo. See the final repo-prep report for the full reasoning; kept
# locally, never committed.
supabase/cleanup_test_accounts.sql

